{
  "name": "ai-memory-lab",
  "version": "1.1.0",
  "private": true,
  "description": "离线三维记忆演化工作台",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tauri dev",
    "desktop": "npm run desktop:windows",
    "desktop:windows": "tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.windows.conf.json --ci --no-sign -- --locked",
    "check:windows": "node ../tools/check_windows_release.mjs",
    "check": "npm run check:ui && node ../tools/check_windows_release.mjs",
    "kernel:build": "python build-kernel.py",
    "kernel:check": "node check-kernel.mjs",
    "check:ui": "node check.mjs && node check-sandbox.mjs && node check-native.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@tauri-apps/cli": "2.12.3"
  }
}
