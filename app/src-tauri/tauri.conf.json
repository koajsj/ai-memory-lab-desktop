{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Memory Lab",
  "version": "1.1.0",
  "identifier": "local.memorylab.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run kernel:check && npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Memory Lab · 记忆演化实验室",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main-local",
          "windows": [
            "main"
          ],
          "permissions": []
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "离线记忆演化与安全边界展示",
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "externalBin": [
      "binaries/memory-kernel"
    ]
  }
}
